# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=3000
API_VERSION=1.2.1
NODE_ENV=development

# ─────────────────────────────────────────────
# Authentication
# Set AUTH_MODE to one of:
#   none    — No auth (open API, for development only)
#   apikey  — API key via x-api-key request header (default)
# ─────────────────────────────────────────────
AUTH_MODE=apikey
API_KEY=your-api-key-here

# ─────────────────────────────────────────────
# Data / Persistence
# This project always persists to PostgreSQL — there is no in-memory mock mode.
# ─────────────────────────────────────────────

# PostgreSQL connection string
# In Codespaces / local dev (API runs natively via `npm run dev`): use "localhost"
#   DATABASE_URL=postgresql://api_user:api_pass@localhost:5432/train_travel_db
# Using docker-compose.full.yml (API runs inside a container): use "postgres"
#   DATABASE_URL=postgresql://api_user:api_pass@postgres:5432/train_travel_db
# External provider (Neon, Supabase, Railway, etc.): use your provider's connection string
DATABASE_URL=postgresql://api_user:api_pass@localhost:5432/train_travel_db

# ─────────────────────────────────────────────
# Pagination
# ─────────────────────────────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
